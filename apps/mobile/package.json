{
  "name": "@sandkasten/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "sync": "cap sync android",
    "build:android": "npm run build && npm run sync && cd android && ./gradlew --no-daemon :app:assembleDebug",
    "test:android": "npm run build && npm run sync && cd android && ./gradlew --no-daemon :app:connectedDebugAndroidTest",
    "android": "cap open android",
    "test:android-e2e": "node scripts/native-e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3",
    "vite": "^7.1.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.5"
  }
}
